# Required for real extraction
SARVAM_API_KEY=

# Sarvam defaults
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_MAX_OUTPUT_TOKENS=4096
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT_SECONDS=90
SARVAM_BATCH_POLL_SECONDS=5
SARVAM_BATCH_TIMEOUT_SECONDS=1800

# Experimental. Keep false until long-meeting recall passes the holdout gates.
CALLRHINO_CANDIDATE_GATING_ENABLED=false

# Optional OpenAI fallback. A key alone does not enable paid calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_FALLBACK_ENABLED=false
OPENAI_SOFT_BUDGET_USD=1.25
OPENAI_HARD_BUDGET_USD=1.50

# Local storage works without Supabase
CALLRHINO_STORAGE_BACKEND=sqlite
CALLRHINO_DB_PATH=data/callrhino.db

# Add these when switching to Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
